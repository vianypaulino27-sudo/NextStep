# NextStep environment variables (NAMES ONLY - never commit real values).
# On Render: Dashboard > csh-nextstep > Environment.

# Postgres connection string (required)
DATABASE_URL=
# Flask session signing key (required in production; any long random string)
SECRET_KEY=
# Set automatically by Render; makes the session cookie Secure (https only)
# RENDER=true

# OPTIONAL, currently NOT used (decision: built-in grounded assistant only).
# If ever set, the assistant may call Anthropic's Messages API for questions
# its knowledge base can't answer, falling back to the built-in answer on any error.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-4-5-20251001
